rules_version = '2';

// Roles live on users/{uid}.role: student (default) | leader | admin.
// Admins are trusted: they may manage leaders, and their word on the
// role field is final.
//
// IMPORTANT: the limits below mirror src/lib/defs.ts. If you change one,
// change both.

// Longest allowed idea title.
// (sync: src/lib/defs.ts MAX_TITLE_LENGTH)
function maxTitleLength() { return 80; }

// Longest allowed idea description.
// (sync: src/lib/defs.ts MAX_DESCRIPTION_LENGTH)
function maxDescriptionLength() { return 2000; }

// Longest timeline update a leader can post.
// (sync: src/lib/defs.ts MAX_TIMELINE_LENGTH)
function maxTimelineLength() { return 500; }

// Minimum seconds between two idea submissions per author.
// (sync: src/lib/defs.ts MIN_IDEA_GAP_SECONDS)
function minIdeaGapSeconds() { return 10; }

// At most this many pending ideas per author at once. NOTE: rules cannot
// query collections, so this is enforced client-side atomically in
// createIdea() (see src/lib/api.ts) and mirrored here as documentation.
// (sync: src/lib/defs.ts MAX_PENDING_PER_AUTHOR)
function maxPendingPerAuthor() { return 5; }

// Longest author-name label on an idea. We only cap the length, not compare
// it to users/{uid}.displayName, since display names drift (edits, provider
// differences) while `authorId == auth.uid` is the real identity check.
// (sync: src/lib/defs.ts MAX_AUTHOR_NAME_LENGTH)
function maxAuthorNameLength() { return 120; }

// Longest display name a user can set on their own profile.
// (sync: src/lib/defs.ts MAX_DISPLAY_NAME_LENGTH)
function maxDisplayNameLength() { return 120; }

// Field on users/{uid} storing the last idea-submission timestamp.
// (sync: src/lib/defs.ts LAST_IDEA_AT_FIELD)
function lastIdeaAtField() { return 'lastIdeaAt'; }

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isLeader() {
      return isSignedIn() && role() in ['leader', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.displayNameSet is bool;
      // A user may update their own display name (once-set flag + rate-limit
      // field) or title; only an admin may change role. The length/type guards
      // only apply when that field is actually being written, so the
      // server-side lastIdeaAt stamp from createIdea still passes.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'displayNameSet', 'title', lastIdeaAtField()])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
          || (
            request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= maxDisplayNameLength()
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayNameSet'])
          || request.resource.data.displayNameSet is bool
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title'])
          || request.resource.data.title.size() <= 60
        );
      allow update: if isAdmin();
    }

    // ---- ideas ----
    match /ideas/{ideaId} {
      allow read: if isSignedIn();

      // Students/leaders submit; every new idea starts in moderation (pending).
      // Guarded against spam: the submitter must have a users/{uid} doc, the
      // title/description are length-capped, the author-name label is
      // length-capped (identity is authorId == auth.uid, not the label),
      // counters start empty, and a per-author rate window applies
      // (write time vs users/{uid}.lastIdeaAt). A brand-new doc cannot be
      // tampered with via extra fields thanks to keys().hasOnly(...).
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= maxAuthorNameLength()
        && request.resource.data.status == 'pending'
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= maxTitleLength()
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= maxDescriptionLength()
        && request.resource.data.timeline.size() == 0
        && request.resource.data.moderationFeedback == null
        && request.resource.data.upvoteUserIds.size() == 0
        && request.resource.data.upvoteCount == 0
        && request.resource.data.supportCount == 0
        && request.resource.data.showAuthorName is bool
        && request.resource.data.keys().hasOnly([
            'title', 'description', 'status', 'authorId', 'authorName',
            'authorTitle', 'upvoteUserIds', 'upvoteCount', 'supportCount',
            'showAuthorName', 'moderationFeedback', 'timeline', 'createdAt',
            'updatedAt',
          ])
        // Rate window: at most one idea submitted every N seconds.
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastIdeaAt == null
          || request.time
            - get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastIdeaAt
            >= duration.value(minIdeaGapSeconds(), 's')
        );

      // Author can delete their own idea.
      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      // Authors may update their own pending or changes_requested ideas;
      // leaders/admins moderate.
      // Leaders also mutate `supportCount`/`timeline` via support + timeline
      // posts.
      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.status in ['pending', 'changes_requested'])
        || isLeader()
      );
    }

    // ---- supports (leader endorsements) ----
    // Clients read supports via collectionGroup, so the read rule lives on the
    // recursive-wildcard group. Writes are direct doc writes: the leader id
    // must match the actor and the name must match their own users doc.
    match /{path=**}/supports/{docId} {
      allow read: if isSignedIn();
      allow create: if isLeader()
        && request.resource.data.ideaId.size() > 0
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.leaderName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.keys().hasOnly([
            'ideaId', 'leaderId', 'leaderName', 'leaderTitle', 'createdAt',
          ]);
      allow delete: if isLeader()
        && resource.data.leaderId == request.auth.uid;
    }

    // ---- invitedLeaders (pre-signup leader invitations) ----
    // Admins may fully manage. Any signed-in user may read (so ensureUserDoc
    // can check the invitation during sign-in) and delete their own
    // invitation (cleaned up during ensureUserDoc on first sign-in).
    // Document ID = email.
    match /invitedLeaders/{email} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSignedIn();
    }
  }
}