rules_version = '2';

// Roles live on users/{uid}.role: student (default) | leader | admin.
// Admins are trusted: they may manage leaders, and their word on the
// role field is final.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isLeader() {
      return isSignedIn() && role() in ['leader', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student';
      // A user may update their own display name; only an admin may change role.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow update: if isAdmin();
    }

    // ---- ideas ----
    match /ideas/{ideaId} {
      allow read: if isSignedIn();

      // Students/leaders submit; every new idea starts in moderation (pending).
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.upvoteUserIds.size() == 0
        && request.resource.data.upvoteCount == 0;

      // Author can delete their own idea.
      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      // Authors may update their own pending ideas; leaders/admins moderate.
      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.status == 'pending')
        || isLeader()
      );
    }

    // ---- supports (leader endorsements) ----
    match /supports/{docId} {
      allow read: if isSignedIn();
      allow create: if isLeader()
        && request.resource.data.leaderId == request.auth.uid;
      allow delete: if isLeader()
        && resource.data.leaderId == request.auth.uid;
    }
  }
}
