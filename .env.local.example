# COPY THIS FILE TO `.env.local` AND FILL IN YOUR FIREBASE VALUES
#
# After you create your Firebase project (see SETUP.md), paste the Web App
# config values here. The public (browser) Firebase config keys are safe to
# commit for a Firebase Web app, but keep .env.local out of git regardless.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Simple Analytics — the website domain shown in your Simple Analytics
# dashboard. Used by the withSimpleAnalytics plugin (next.config.ts) to proxy
# tracking requests, and exposed to the client via NEXT_PUBLIC_*.
NEXT_PUBLIC_SIMPLE_ANALYTICS_HOSTNAME=example.com
SIMPLE_ANALYTICS_HOSTNAME=example.com